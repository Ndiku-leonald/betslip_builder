# SlipIQ environment template. Never put real credentials in this file.
APP_ENV=development
APP_TIMEZONE=Africa/Kampala
APP_PROCESS_ROLE=web
LOG_LEVEL=INFO
APP_VERSION=0.1.0
RELEASE=
DATABASE_URL=sqlite:///./slipiq.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=
REDIS_REQUIRED_IN_PRODUCTION=true
REDIS_KEY_PREFIX=slipiq
API_FOOTBALL_KEY=
API_BASKETBALL_KEY=
API_SPORTS_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_BASKETBALL_BASE_URL=https://v1.basketball.api-sports.io
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# The Odds API — optional bookmaker prices for Stage Three.
# Paste the secret only into your local .env file; never commit it here.
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
THE_ODDS_API_DAILY_LIMIT=
BETPAWA_FEED_URL=
BETPAWA_API_KEY=
LIVESCORE_FOOTBALL_BASE_URL=https://worldcup26.ir
ENABLE_LIVESCORE_FOOTBALL=true
ENABLE_EASY_SOCCER_DATA=false
# Keep disabled until THE_ODDS_API_KEY is populated in .env.
ENABLE_ODDS_API=false
ODDS_PREMATCH_TTL_SECONDS=1800
ODDS_LIVE_TTL_SECONDS=30
LIVE_DATA_STALE_SECONDS=120
LIVE_STATS_STALE_SECONDS=180
LIVE_ODDS_STALE_SECONDS=30
LIVE_REFRESH_COOLDOWN_SECONDS=30
ENABLE_SCHEDULED_LIVE_ODDS=true
API_CORS_ORIGINS=http://localhost:3000
QUOTA_MODE=free
API_FOOTBALL_DAILY_LIMIT=
API_BASKETBALL_DAILY_LIMIT=
FOOTBALL_DATA_DAILY_LIMIT=

# Additional provider slots. Keep credentials in .env only. Set the official
# adapter name after its API documentation has been reviewed; "pending" is
# intentionally not queried by the application.
ADDITIONAL_PROVIDER_1_NAME=
ADDITIONAL_PROVIDER_1_SPORTS=football,basketball
ADDITIONAL_PROVIDER_1_BASE_URL=
ADDITIONAL_PROVIDER_1_API_KEY=
ADDITIONAL_PROVIDER_1_AUTH_HEADER=Authorization
ADDITIONAL_PROVIDER_1_ADAPTER=pending
ADDITIONAL_PROVIDER_2_NAME=
ADDITIONAL_PROVIDER_2_SPORTS=football,basketball
ADDITIONAL_PROVIDER_2_BASE_URL=
ADDITIONAL_PROVIDER_2_API_KEY=
ADDITIONAL_PROVIDER_2_AUTH_HEADER=Authorization
ADDITIONAL_PROVIDER_2_ADAPTER=pending
ADDITIONAL_PROVIDER_3_NAME=
ADDITIONAL_PROVIDER_3_SPORTS=football,basketball
ADDITIONAL_PROVIDER_3_BASE_URL=
ADDITIONAL_PROVIDER_3_API_KEY=
ADDITIONAL_PROVIDER_3_AUTH_HEADER=Authorization
ADDITIONAL_PROVIDER_3_ADAPTER=pending
ADDITIONAL_PROVIDER_4_NAME=
ADDITIONAL_PROVIDER_4_SPORTS=football,basketball
ADDITIONAL_PROVIDER_4_BASE_URL=
ADDITIONAL_PROVIDER_4_API_KEY=
ADDITIONAL_PROVIDER_4_AUTH_HEADER=Authorization
ADDITIONAL_PROVIDER_4_ADAPTER=pending
ADDITIONAL_PROVIDER_5_NAME=
ADDITIONAL_PROVIDER_5_SPORTS=football,basketball
ADDITIONAL_PROVIDER_5_BASE_URL=
ADDITIONAL_PROVIDER_5_API_KEY=
ADDITIONAL_PROVIDER_5_AUTH_HEADER=Authorization
ADDITIONAL_PROVIDER_5_ADAPTER=pending
ADDITIONAL_PROVIDER_6_NAME=
ADDITIONAL_PROVIDER_6_SPORTS=football,basketball
ADDITIONAL_PROVIDER_6_BASE_URL=
ADDITIONAL_PROVIDER_6_API_KEY=
ADDITIONAL_PROVIDER_6_AUTH_HEADER=Authorization
ADDITIONAL_PROVIDER_6_ADAPTER=pending
LIVE_POLL_SECONDS=60
PREMATCH_REFRESH_MINUTES=30
ODDS_REFRESH_SECONDS=60
ENABLE_SCHEDULED_INGESTION=false
PROVIDER_CONNECT_TIMEOUT=5
PROVIDER_READ_TIMEOUT=15
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=0.5
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60
EXPENSIVE_RATE_LIMIT_REQUESTS=10
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1000000
REQUEST_ID_MAX_LENGTH=96
STRICT_SECURITY_HEADERS=true
ENABLE_API_DOCS=true
METRICS_ENABLED=true
ENABLE_ADMIN_ENDPOINTS=true
ADMIN_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8000
